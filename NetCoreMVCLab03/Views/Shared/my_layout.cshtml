    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "my_layout";
}
<!DOCTYPE html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" ,content="width=device-width, initial-scale=1" />
    <title>NetCore 2.x - @ViewBag.Title</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="nav navbar-inverse">
        <div class="container"> 
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">NetcoreMVCLab3</a>
            <ul class="navbar navbar-nav">
                <li class="active"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Home" asp-action="About">Gioi thieu</a></li>
                <li><a asp-controller="Book" asp-action="Index">Book</a></li>
            </ul>
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
    <script src="http://code.jquery.com/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    @RenderSection("Scripts", required:false)
</body>

