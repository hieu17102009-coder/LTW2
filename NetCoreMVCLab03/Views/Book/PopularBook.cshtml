@model IEnumerable<NetCoreMVCLab03.Models.Book>
@{
    ViewData["Title"] = "PopularBook";
}
@foreach(var item in Model)
{
    <div class="col-xs-3 col-md-3 col-sm-3 col-lg-3"  >
        <div class="thumbnail">
            <img  src="@item.Image" alt=""/ width="100">
            <div class="capption">
                <h3>@item.Title</h3>
                <p>@item.Price</p>
            </div>
        </div>
    </div>
}