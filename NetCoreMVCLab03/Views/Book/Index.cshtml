@model IEnumerable<NetCoreMVCLab03.Models.Book>
@{
    ViewData["Title"] = "Index";
}
<h2>Danh sách các cuốn sách </h2>
<form action="" method="POST" role="form" class="mb-4">
    <div class="form-group">
        <div class="col-md-7">
            <div class="align-items-center d-flex gap-2">
                <div class="col-md-4">
                    <select name="AuthorId" class="form-control" asp-items="@ViewBag.Authors">
                        <option value="">Chọn tác giả</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select name="GenreId" class="form-control" asp-items="@ViewBag.Genres">
                        <option value="">Chọn thể loại</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-success w-100">Tìm kiếm</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Create" class="btn btn-danger w-100">Thêm mới</a>
                </div>
            </div>
        </div>
      
            
    </div>    
</form>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tiêu đề</th>
            <th>Tác giả</th>
            <th>Thể loại</th>
            <th>Giá</th>
            <th>Hình ảnh</th>    
            <th></th>

        </tr>
    </thead>
    <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.AuthorId</td>
                    <td>@book.GenreId</td>
                    <td>@book.Price</td>
                    <td>
                        <img src="@book.Image" alt="@book.Title" width="40"/>
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn tbn-sm btn-primary">Sửa</a>
                    </td>
                </tr>
            }
    </tbody>
</table>
