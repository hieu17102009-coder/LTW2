@model IEnumerable<Nvh_Th2_Lab04.Models.Learner>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
@await Component.InvokeAsync("Major")
<form class="form-inline">
    <div class="input-group">
        <input id="keyword" class="form-control" name="keyword" type="text" placeholder="Search Learner"/>
        <button id="btnSearch" class="btn btn-primary" type="button"><i class="fas fa-search"></i></button>
    </div>
</form>

<div id="content">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.LearnerId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LastName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FirstMidName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EnrollmentDate)
                </th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayNameFor(model => item.LearnerId)</td>
                    <td>
                        @Html.DisplayFor(model => item.LastName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.FirstMidName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.EnrollmentDate)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.LearnerId">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.LearnerId">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.LearnerId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <ul class="pagination">
        @for(int i = 1; i <= ViewBag.pageNum; i++)
        {
            <li class="page-item" page="@i" 
                @(ViewBag.mid !=null ? "mid = 'ViewBag.mid'" : "")
                @(ViewBag.keyword !=null ? "keyword = 'ViewBag.keyword'" : "")
            ><a class="page-link">@i</a></li>
        }
    </ul>
</div>
<a asp-action="Create">Create New</a>
@section Scripts{
    <script>
        $(".nav li").click(function (e) {
            var id = $(this).attr("id");
            $.ajax({
                url: "Learner/LearnerFilter",
                data: { mid: id },
                success: function (response) {
                    $("div#content").html(response);
                }
            });
        });

        $('body').on('click', 'li.page-item', function (e) {
            var page = $(this).attr("page");
            var mid = $(this).attr("mid");
            var keyword = $(this).attr("keyword");
            var data = { mid: mid, keyword: keyword, pageIndex: page }
            $.ajax({
                url: "Learner/LearnerFilter",
                data: data,
                success: function (response) {
                    $("div#content").html(response);
                }

            });
        });

        $("button#btnSearch").click(function (e) {
            var keyword = $("#keyword").val();
            var data = { keyword: keyword };
            $.ajax({
                url: "LearnerFilter",
                data: data,
                success: function(response){
                    $("div#content").html(response);
                }
            });
        });
    </script>
}