@model IEnumerable<Nvh_THWLab01.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-route="student_add" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                Mã
            </th>
            <th>
                Họ tên
            </th>
            <th>
                Ngày sinh
            </th>
            <th>
                Ảnh đại diện
            </th>
            <th>
                Ngành
            </th>
            <th>
                Giới tính
            </th>
            <th>
                Hệ ĐT
            </th>
            <th>
                Địa chỉ
            </th>
            <th>
                Email
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.Id
            </td>
            <td>
                @item.Name
            </td>
            <td>
                @item.DateOfBirth
            </td>
            <td>
                <img src="@item.Image" class="w-100" alt="Anh dai dien" >
            </td>
            @{
                    string str = "";
                    switch (item.Branch)
                    {
                        case Branch.IT:
                            str = "CNTT"; break;
                        case Branch.BE:
                            str = "Kinh tế";
                            break;
                        case Branch.CE:
                            str = "Công trình";
                            break;
                        case Branch.EE:
                            str = "Điện - Điện tử ";
                            break;
                    }
             }
            <td>@str</td>
            <td>
                @(item.Gender == Gender.Male ? "Nam" : "Nữ")
            </td>
            <td>
                @(item.IsRegular ? "Hệ chính quy" : "Hệ phi chính quy")
            </td>
            <td>
                @item.Address
            </td>
            <td>
                @item.Email
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
@section Scripts{
    <script>
        var table = document.querySelector("table");
        table.onclick = function onTableClick(){
            table.style = "background : yellow";
        }
    </script>
};