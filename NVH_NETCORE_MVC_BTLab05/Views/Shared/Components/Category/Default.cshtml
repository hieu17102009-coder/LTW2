@model IEnumerable<NVH_NETCORE_MVC_BTLab05.Models.Category>
@{
}
<div class="card-header fw-bold py-3"> <i class="bi bi-grid me-2"></i> Danh mục sản phẩm </div>
<div class="list-group list-group-flush">
    @foreach(var item in Model)
    {
        <a asp-controller="Product" asp-action="Index" asp-route-id ="@item.Id" class="list-group-item list-group-item-action" style="background-color: lightgreen">@item.Name</a>
       
    }

</div>
