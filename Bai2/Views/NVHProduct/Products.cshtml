@{
    ViewData["Title"] = "Products";
}

<table class="table table-active">
    <thead>
        <th>Id</th>
        <th>Name</th>
        <th>Year</th>
    </thead>
    <tbody class="table tab-content">
        @foreach (var p in ViewBag.products)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.YearRelease</td>
            </tr>
        }
    </tbody>

</table>